# Copia a .env (o ejecuta `../scripts/setup-mobile-release.sh env` desde la raíz).

# API del backend
# - Sin servidor local: usa Railway (recomendado para probar en iPhone)
EXPO_PUBLIC_API_BASE_URL=https://optimizador-tdah-production.up.railway.app
# - Con servidor local (`npm run dev` en la raíz del repo, mismo WiFi):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Sincronización en la nube (opcional). No uses un proyecto Supabase muerto/NXDOMAIN.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Redirect OAuth nativo (debe estar en Supabase → Auth → URL Configuration).
# En Expo web se ignora: se usa EXPO_PUBLIC_AUTH_WEB_BRIDGE_URL (puente local :3000).
# EXPO_PUBLIC_AUTH_REDIRECT_URL=nucleo://login-callback
# EXPO_PUBLIC_AUTH_WEB_BRIDGE_URL=http://127.0.0.1:3000/auth/callback

# Legal (opcionales; por defecto usan {API}/privacidad y {API}/terminos)
# EXPO_PUBLIC_PRIVACY_URL=https://optimizador-tdah-production.up.railway.app/privacidad
# EXPO_PUBLIC_TERMS_URL=https://optimizador-tdah-production.up.railway.app/terminos

# Monetización (RevenueCat). Sin key, el paywall se muestra pero la compra no está activa;
# Pro de equipo sigue por allowlist de email en el servidor.
# EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxx

# Para builds EAS en CI (opcional):
# EXPO_TOKEN=...

# Para configurar redirects OAuth en Supabase vía script (opcional):
# SUPABASE_ACCESS_TOKEN=...

# Personal Team de Xcode (opcional; se detecta del certificado Apple Development):
# APPLE_TEAM_ID=XXXXXXXXXX
