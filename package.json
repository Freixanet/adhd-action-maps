{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "tokens:generate": "node scripts/design-tokens/generate.mjs",
    "tokens:check": "node scripts/design-tokens/generate.mjs --check",
    "check:design-tokens": "npm run tokens:check && node scripts/design-tokens/check.mjs",
    "validate": "npm run check:design-tokens && npm test && npm run lint --prefix mobile",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "mobile:bundle:ios": "bash scripts/mobile-bundle-ios.sh",
    "mobile:check:shared-resolve": "node mobile/scripts/check-metro-shared-resolve.cjs",
    "mobile:preview": "bash scripts/mobile-preview-bridge.sh"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "1.12.0",
    "@firecrawl/pdf-inspector-wasm": "0.1.3",
    "@google/genai": "^2.4.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "epub2": "^3.0.2",
    "express": "^4.21.2",
    "ipaddr.js": "^2.4.0",
    "jsdom": "^27.0.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.19.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-wrap-balancer": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "undici": "7.29.0",
    "vite": "^6.2.3",
    "youtube-transcript": "^1.3.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.1.14",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supabase": "^2.107.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
