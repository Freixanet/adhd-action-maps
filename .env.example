# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Preferred model(s) used to generate the action maps.
# Accepts a single model or a comma-separated priority list. The server always
# appends a built-in fallback chain (gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite), so if a model runs out of daily/per-minute quota (429)
# or is overloaded (503), it automatically switches to the next available model.
# Free users resolve to gemini-3.6-flash → gemini-3.5-flash-lite; gemini-3.5-flash is Pro-only.
# Example (try Flash Lite first, then the defaults):
# GEMINI_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional cloud sync. Keep server keys out of Vite variables and never commit .env.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only: required for POST /api/account/delete (Auth Admin API).
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# REQUIRE_AUTH: default true when SUPABASE_URL looks real. Set false for local anon metering.
# REQUIRE_AUTH="false"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# VITE_API_BASE_URL: Optional override for API host. Leave empty for web (same-origin /api).
# VITE_API_BASE_URL="https://optimizador-tdah-production.up.railway.app"
ALLOWED_ORIGINS="https://app.example.com"
# NUCLEO_PRO_EMAILS: cuentas con Pro permanente (coma-separadas). Incluye marcfreixanet@gmail.com por defecto en código.
# NUCLEO_PRO_EMAILS="otro@ejemplo.com"
RATE_LIMIT_MAX="10"
RATE_LIMIT_WINDOW_MS="600000"
MAX_UPLOAD_BYTES="15728640"
# MAX_JSON_BODY="20mb"
# MAX_REMOTE_FETCH_BYTES="5242880"
