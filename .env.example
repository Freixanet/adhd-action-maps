# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Preferred model(s) used to generate the action maps.
# Accepts a single model or a comma-separated priority list. The server always
# appends a built-in fallback chain:
#   gemini-3.7-flash (extended thinking) → gemini-3.7-flash
#   → gemini-3.5-flash-lite (extended thinking) → gemini-3.5-flash-lite
# If a model runs out of daily/per-minute quota (429) or is overloaded (503),
# it automatically switches to the next available model.
# Example (try Flash Lite first, then the defaults):
# GEMINI_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional cloud sync. Keep server keys out of Vite variables and never commit .env.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only: required for POST /api/account/delete (Auth Admin API).
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# REQUIRE_AUTH: default true when SUPABASE_URL looks real. Set false for local anon metering.
# REQUIRE_AUTH="false"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# VITE_API_BASE_URL: Optional override for API host. Leave empty for web (same-origin /api).
# VITE_API_BASE_URL="https://optimizador-tdah-production.up.railway.app"
ALLOWED_ORIGINS="https://app.example.com"
# NUCLEO_PRO_EMAILS: cuentas con Pro permanente (coma-separadas). Incluye marcfreixanet@gmail.com por defecto en código.
# NUCLEO_PRO_EMAILS="otro@ejemplo.com"
# REVENUECAT_SECRET_API_KEY: server-only. When set, Pro is resolved from the
# RevenueCat `pro` entitlement (app user id = Supabase user id). Allowlist is fallback.
# REVENUECAT_SECRET_API_KEY=sk_xxx
RATE_LIMIT_MAX="10"
RATE_LIMIT_WINDOW_MS="600000"
MAX_UPLOAD_BYTES="15728640"
# MAX_JSON_BODY="20mb"
# MAX_REMOTE_FETCH_BYTES="5242880"
# ENABLE_EXPANDED_INPUTS: epub / docx / image OCR ingest (ADR-002). Off → 501.
# ENABLE_EXPANDED_INPUTS="true"

# PDF Inspector: mejora local y opcional de estructura (tablas, columnas y Markdown).
# auto = motor nativo en producción; WASM compatible en desarrollo; pdf.js si falla.
# No activa OCR ni envía el PDF a terceros.
# PDF_INSPECTOR_MODE="auto" # auto | native | wasm | off
# PDF_INSPECTOR_TIMEOUT_MS="2500"

# Editorial illustrations — Streamline Public API (server only, never ship to the client).
# Locked family slug: ux-line (UX Line). Only free icons from that family are selected.
# Empty key → local editorial SVG scenes; generation never blocks on Streamline.
# STREAMLINE_API_KEY=
# STREAMLINE_SEARCH_TIMEOUT_MS=1600

# Núcleo card covers — Gemini image models (server only). Default chain:
# gemini-3.1-flash-lite-image → gemini-3.1-flash-image → gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=
